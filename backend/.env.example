# MiniMax
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=minimax-m3

# Feishu
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_REDIRECT_URI=http://localhost:8085/api/v1/auth/callback
FEISHU_BITABLE_APP_TOKEN=xxxxxxxxxxxxx
FEISHU_BITABLE_TABLE_ID=xxxxxxxxxxxxx
FEISHU_BITABLE_VIEW_ID=xxxxxxxxxxxxx

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./ecommerce_selection.db

# JWT
JWT_SECRET_KEY=change-this-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8085
LOG_LEVEL=INFO

# Auth
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_FILE=./server.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
